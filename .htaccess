<FilesMatch "\.(htm|html|php)$">
    <IfModule mod_headers.c>
        BrowserMatch MSIE ie
        Header set X-UA-Compatible "IE=Edge,chrome=1" env=ie
    </IfModule>
</FilesMatch>

# Always use https for secure connections (only on production)
RewriteEngine On
RewriteCond %{HTTP_HOST} !^abaracus\.lndo\.site$ [NC]
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://www.abaracus.com/$1 [R=301,L]

# One year for image files
<filesMatch ".(jpg|jpeg|png|gif|ico)$">
Header set Cache-Control "max-age=31536000, public"
</filesMatch>
# One month for css and js
<filesMatch ".(css|js)$">
Header set Cache-Control "max-age=2628000, public"
</filesMatch>
Options -Indexes

# Serve error pages locally to preserve the original HTTP status.
ErrorDocument 404 /404.html
ErrorDocument 403 /403.html

# The portfolio uses direct contact details. Retire the old PHP mail and
# Twitter endpoints, including copies in the archived template directories.
<FilesMatch "(?i)\.php$">
    Require all denied
</FilesMatch>
